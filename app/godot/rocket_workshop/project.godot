; Engine configuration file.
; Edit with the Godot editor when possible.

config_version=5

[application]

config/name="Oficina do Foguete"
config/description="Protótipo Godot para uma oficina 3D de manipulação direta e lançamento simulado."
run/main_scene="res://scenes/main_3d.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
